{
  "name": "forgecrew-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run smoke",
    "dev:dispatcher": "node --experimental-strip-types packages/dispatcher/src/main.ts",
    "doctor": "node --experimental-strip-types packages/worker/src/cli.ts doctor",
    "smoke": "node scripts/smoke.mjs && node --experimental-strip-types scripts/package-smoke.mjs && node --experimental-strip-types scripts/update-smoke.mjs",
    "format": "prettier --write \"packages/**/*.{ts,mjs}\" \"tests/**/*.{ts,cjs}\" \"scripts/*.mjs\" tsdown.config.ts",
    "format:check": "prettier --check \"packages/**/*.{ts,mjs}\" \"tests/**/*.{ts,cjs}\" \"scripts/*.mjs\" tsdown.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@octokit/rest": "22.0.1",
    "better-sqlite3": "13.0.3",
    "cross-spawn": "7.0.6",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
